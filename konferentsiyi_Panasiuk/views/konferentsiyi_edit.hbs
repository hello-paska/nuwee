<div class="container" style="min-height: 50vh">
    <div class="row">
        <div class="col-xs-12 col-md-6 text-center mx-auto">
            <h2 class="text-primary">Конференція
            &#8220;{{konferentsiyi.nazva_konferentsiyi}}&#8221;
            <br>(редагування)
            </h2>
            <form method="post" name="form1" action="/konferentsiyi_edit">
                <input type="hidden" name="_csrf" value="{{csrfToken}}" id="csrfToken">
                <div class="form-group">
                    <label for="id_spivrobitnyky">Відповідальний</label>
                    <input list="id" class="form-control" name="id_spivrobitnyky"
                        placeholder="Вкажіть відповідального" autocomplete="off"
                        value="{{konferentsiyi.id_spivrobitnyky}}">
                    <datalist id="id">
                        {{#each spivrobitnyky}}
                        <option value="{{this.id_spivrobitnyky}}">
                        {{this.prizvyshche}}
                        </option>
                        {{/each}}
                    </datalist>
                </div>
                <div class="form-group">
                    <label for="nazva_konferentsiyi">Назва конференції</label>
                    <input type="text" class="form-control" name="nazva_konferentsiyi" placeholder="Вкажіть назву"
                    value="{{konferentsiyi.nazva_konferentsiyi}}">
                </div>
                <div class="form-group">
                    <label for="data_pochatku">Дата початку</label>
                    <input type="date" class="form-control" name="data_pochatku"
                    value="{{konferentsiyi.data_pochatku}}">
                </div>
                <div class="form-group">
                    <label for="data_zakinchennya">Дата закінчення</label>
                    <input type="date" class="form-control" name="data_zakinchennya"
                    value="{{konferentsiyi.data_zakinchennya}}">
                </div>
                <input type="hidden" name="id_konferentsiyi" value="{{konferentsiyi.id_konferentsiyi}}" />
                <button type="submit" class="btn btn-primary mx-2 my-2">Зберегти</button>
                <button type="reset" class="btn btn-primary">Очистити</button>
            </form>
        </div>
    </div>
</div>
