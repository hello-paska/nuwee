<div class="container-fluid" style="min-height: 50vh">
    <div class="row">
        <div class="col-12 text-center">
            <h1 class="text-primary">Конференції</h1>
        </div>
    </div>

    {{#if konferentsiyi_visible}}
    <div class="row">
        <div class="col-12 text-center">
            <h2 class="text-primary">з: {{data_pochatku}} по: {{data_zakinchennya}}</h2>
        </div>
    </div>

    {{else}}

    <div class="row">
        <div class="col-12">
            <form method="post" class="form-inline my-2">
                <input type="hidden" name="_csrf" value="{{csrfToken}}" id="csrfToken">
                <div class="form-group mx-auto">
                    <div class="form-group">
                        <label for="data_pochatku">з</label>
                        <input type="date" class="form-control mx-2" name="data_pochatku" required>
                    </div>
                    <div class="form-group">
                        <label for="data_zakinchennya">по</label>
                        <input type="date" class="form-control mx-2" name="data_zakinchennya" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Показати</button>
                </div>
            </form>
        </div>
    </div>

    {{/if}}

    {{#if konferentsiyi_visible}}

    {{#if isAdmin}}
    <div class="text-right">
        <a href="/konferentsiyi_create" class="btn btn-primary btn-sm my-2">Додати запис</a>
    </div>
    {{/if}}

    <div class="row">

        {{#each konferentsiyi}}

        <div class="card text-center col-md-6">
            <div class="card-header"> Код конференції: <b>{{this.id_konferentsiyi}}</b></div>
            <div class="card-body">
                <h5 class="card-title">{{this.nazva_konferentsiyi}}</h5>
                <p class="card-text">Відповідальний: <b>{{this.prizvyshche}}</b></p>
                <p class="card-text"><h6>{{this.data_pochatku}} - {{this.data_zakinchennya}}</h6></p>
                <p class="card-text">Тривалість: <b>{{this.truvalist}}</b> дн.</p>
            </div>
            {{#if ../isAdmin}}
            <div class="card-footer text-muted">
                <form action="konferentsiyi_delete/{{this.id_konferentsiyi}}" method="POST" style="display:inline;">
                    <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                    <input type="submit" value="Видалити" class="btn btn-warning btn-sm"/>
                </form>
                <a href="/konferentsiyi_edit/{{this.id_konferentsiyi}}" class="btn bg-success btn-sm">Редагувати</a>
            </div>
            {{/if}}
        </div>

        {{else}}
        <div class="col-12 text-center text-muted">За вибраний період конференцій не знайдено</div>
        {{/each}}
    </div>

    {{/if}}
</div>
